# Production only: where the browser finds FastAPI when it is NOT served from the
# same origin as the frontend (no trailing slash). Leave unset to use same-origin /api.
# VITE_API_BASE_URL=https://api.example.org

# Dev/preview only: where the Vite proxy forwards /api. Default http://127.0.0.1:8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Basemap tiles (default: Esri World Street Map, no key, light use only; falls back to OpenStreetMap).
# For public deployments use a keyed provider and keep its required attribution:
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
